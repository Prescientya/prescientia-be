DB_HOST=127.0.0.1 
DB_PORT=3306 #mysql
DB_NAME=nama database
DB_USER=nama user database
DB_PASSWORD=pw user

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# WAJIB: Ganti dengan random 512-bit hex yang unik. Jangan pernah commit nilai nyata ke repo.
# Generate dengan: node -e "const c=require('crypto');console.log(c.randomBytes(64).toString('hex'))"
JWT_SECRET=GANTI_DENGAN_RANDOM_512BIT_HEX_UNIK_DI_SINI
JWT_STUDENT_EXPIRE=30d
JWT_TEACHER_EXPIRE=30d

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Error logging
ERROR_LOG_TO_FILE=false